{
  "expo": {
    "name": "Na Brasa - Cardápio",
    "slug": "cardapio-digital",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "na-brasa",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
